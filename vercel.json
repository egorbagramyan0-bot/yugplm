{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/contacts",
      "destination": "/company",
      "permanent": false
    },
    {
      "source": "/sprut-cam",
      "destination": "/software/sprutcam",
      "permanent": false
    },
    {
      "source": "/sprut-tp",
      "destination": "/software/sprut-tp",
      "permanent": false
    },
    {
      "source": "/sprut-okp",
      "destination": "/software/sprut-okp",
      "permanent": false
    },
    {
      "source": "/licenses",
      "destination": "/certificates",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
